{
  "name": "@softtech/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-aliases.mjs dist",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && vitest run --config vitest.e2e.config.mts",
    "test:unit": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:integration": "node prisma/generate.mjs && vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "prisma:generate": "node prisma/generate.mjs",
    "prebuild": "node prisma/generate.mjs",
    "pretest": "node prisma/generate.mjs",
    "pretypecheck": "node prisma/generate.mjs",
    "postinstall": "node prisma/generate.mjs",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@sentry/node": "11.8.0",
    "dotenv": "18.0.8",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.3",
    "@softtech/eslint-config": "workspace:*",
    "@softtech/tsconfig": "workspace:*",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "catalog:",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
