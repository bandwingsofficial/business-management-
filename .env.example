# =============================================================================
# Softtech Core — local environment template (dummy / safe defaults)
# =============================================================================
#
# Copy to .env for API development:
#   pnpm env:setup
#
# This file contains no production credentials. Replace placeholders with your
# own values only on your machine. Never commit .env.
#
# Variable roles:
#   DATABASE_URL              → API runtime PostgreSQL (optional until connected)
#   INTEGRATION_DATABASE_URL  → disposable integration tests only (see .env.integration.example)
#   REDIS_URL                 → API runtime Redis (optional until connected)
#   INTEGRATION_REDIS_URL     → isolated integration-test Redis only
#
# The API never substitutes DATABASE_URL for INTEGRATION_DATABASE_URL.
# =============================================================================

# --- General application -------------------------------------------------------

NODE_ENV=development
APP_NAME=Softtech Core

# --- API HTTP ------------------------------------------------------------------

API_HOST=0.0.0.0
API_PORT=3001
API_PREFIX=api
API_DEFAULT_VERSION=1

# Comma-separated browser origins. Production defaults to none when unset.
CORS_ORIGINS=http://localhost:3000

# Body limit 1 MiB default. Timeout 30s default.
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_TIMEOUT_MS=30000

# Trust exactly one reverse proxy hop when true.
TRUST_PROXY=false

# Global HTTP rate limit (per process or shared via Redis when REDIS_URL is set).
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=300

# Auth attempts per client address before token verification.
AUTH_RATE_LIMIT_MAX=20

# --- Security headers ----------------------------------------------------------

HELMET_ENABLED=true

# --- Logging -------------------------------------------------------------------

LOG_LEVEL=info

# --- OpenAPI (development default on) ------------------------------------------

OPENAPI_ENABLED=true
# OPENAPI_TITLE=Softtech Core
# OPENAPI_DESCRIPTION=Softtech Core HTTP API

# --- PostgreSQL (application runtime) ------------------------------------------
#
# Optional until you connect the API to PostgreSQL. Development Compose uses
# database name "softtech" on port 5432. Integration tests use a different
# variable and database name — see Integration testing below.

# DATABASE_URL=postgresql://softtech:softtech@127.0.0.1:5432/softtech

DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=5000

# --- Redis (application runtime) -----------------------------------------------
#
# Optional until you connect the API to Redis. When set, auth rate limiting is
# shared across API replicas.

# REDIS_URL=redis://127.0.0.1:6379

REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_MAX_RETRIES=2

# --- Authentication (external IdP / JWKS) ------------------------------------
#
# Set all three together, or leave all unset. Unset means protected routes fail
# closed with 401 until JWKS is configured.

# AUTH_ISSUER=https://auth.example.com
# AUTH_AUDIENCE=softtech-api
# AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# --- Observability -------------------------------------------------------------

# Traces export to {endpoint}/v1/traces when set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# SENTRY_DSN=https://example@sentry.example.com/0

# RELEASE=local-dev

# Protects GET /api/v1/metrics when set (minimum 16 characters).
# METRICS_TOKEN=local-metrics-token-min-16-ch

# --- Email (SMTP) --------------------------------------------------------------

EMAIL_DRIVER=none
# EMAIL_FROM=noreply@example.com
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_PASSWORD=example-not-a-real-password

# --- Object storage ------------------------------------------------------------
#
# none is the only production storage driver. s3 is not implemented at runtime.

STORAGE_DRIVER=none
# STORAGE_BUCKET=example-bucket
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=http://127.0.0.1:9000
# STORAGE_ACCESS_KEY_ID=example-key-id
# STORAGE_SECRET_ACCESS_KEY=example-secret-key

# --- Background jobs -----------------------------------------------------------
#
# none disables job delivery. redis is rejected in production until a dispatcher
# polls outbox_messages.

JOBS_DRIVER=none

# --- Integration testing (NOT loaded by the API at startup) --------------------
#
# Use .env.integration.example → .env.integration and pnpm test:integration, or
# set these in the shell for one test run. Dummy values match docker-compose.test.yml.
#
# INTEGRATION_DATABASE_URL=postgresql://softtech:softtech@127.0.0.1:5433/softtech_test
# INTEGRATION_REDIS_URL=redis://127.0.0.1:6380/15

# --- Local Docker services (reference) -----------------------------------------
#
# Development stack (database softtech, not softtech_test):
#   docker compose -f docker-compose.dev.yml up -d
#   DATABASE_URL=postgresql://softtech:softtech@127.0.0.1:5432/softtech
#   REDIS_URL=redis://127.0.0.1:6379
#
# Disposable integration stack:
#   docker compose -f docker-compose.test.yml up -d
#   See .env.integration.example

# --- Web (apps/web) ------------------------------------------------------------
#
# No server secrets are required for the web app today. Only variables prefixed
# with NEXT_PUBLIC_ are exposed to browser bundles. Do not put API secrets here.
#
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
