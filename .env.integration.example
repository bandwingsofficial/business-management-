# =============================================================================
# Softtech Core — integration-test environment (disposable services only)
# =============================================================================
#
# Create a local copy (does not overwrite an existing file):
#   pnpm env:setup:integration
#
# Check configuration (no migrations, no secrets printed):
#   pnpm env:check:checkpoint   — foundation work; Redis may show DEFERRED
#   pnpm env:check              — strict; Redis must be reachable
#   pnpm verify:foundation      — full foundation checkpoint
#   pnpm verify:infrastructure  — strict env + integration tests (needs Redis)
#
# PostgreSQL: use your local server (pgAdmin) OR Docker test compose.
# Redis: required for integration tests. Docker test compose exposes port 6380.
#        A local Redis install can use port 6379 instead — keep index /15 in the URL.
#
# URL-encode special characters in passwords (for example @ → %40).
#
# DATABASE_URL and REDIS_URL are intentionally absent here. The integration runner
# uses INTEGRATION_DATABASE_URL and INTEGRATION_REDIS_URL only.
# =============================================================================

# Local PostgreSQL on port 5432 (typical pgAdmin / native install):
# INTEGRATION_DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/softtech_test

# Docker test Postgres from docker-compose.test.yml (port 5433):
# INTEGRATION_DATABASE_URL=postgresql://softtech:softtech@127.0.0.1:5433/softtech_test

INTEGRATION_DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/softtech_test

# Docker test Redis (docker compose -f docker-compose.test.yml up -d):
INTEGRATION_REDIS_URL=redis://127.0.0.1:6380/15

# Local Redis on default port:
# INTEGRATION_REDIS_URL=redis://127.0.0.1:6379/15
